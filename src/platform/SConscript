# T-Display-SF32 platform code: board, radio driver, RTC, RNG and MeshCore's target.h.
import os
from building import *

cwd = GetCurrentDir()

# The build date (sf32_platform.h: FIRMWARE_BUILD_DATE), "21 Nov 2026" like MeshCore's own.
# Rewritten only when the date changes, so only this file rebuilds. SOURCE_DATE_EPOCH, if
# set, fixes it (reproducible builds).
import time
_t = time.localtime(int(os.getenv('SOURCE_DATE_EPOCH'))) if os.getenv('SOURCE_DATE_EPOCH') else time.localtime()
_date = '%d %s %d' % (_t.tm_mday, 'Jan Feb Mar Apr May Jun Jul Aug Sep Oct Nov Dec'.split()[_t.tm_mon - 1], _t.tm_year)
_bd = os.path.join(cwd, 'sf32_build_date.c')
_txt = ('// Generated by src/platform/SConscript at build time (not in git): the build date.\n'
        'const char sf32_build_date[] = "%s";\n' % _date)
if not os.path.exists(_bd) or open(_bd).read() != _txt:
    with open(_bd, 'w') as f:
        f.write(_txt)

src = Glob('*.cpp') + Glob('*.c')
# The BLE transport needs the Bluetooth stack, which only the companion project enables;
# the USB app interface (the app protocol over USB) is the companion's too.
if os.getenv('SF32_FIRMWARE', 'repeater') != 'companion':
    src = [s for s in src if not s.name.startswith('SF32SerialBLEInterface') and not s.name.startswith('SF32UsbInterface')]

# SF32_UI_DEMO=t_t_U_240,300 ./build.sh companion: test firmware that plays touch
# input, one step every 8 s from 10 s after boot (screenshots with
# tools/sf32_debug_uart.py shot; UI work only). Steps: t = tap, L = long press,
# U / D = swipe up / down, l / r = swipe left / right, X,Y = tap at panel coordinates
# (menus), . = wait, B = show the battery-empty screen;
# '_' separates.
# SF32_UI_DEMO_TIME=<epoch>: set the RTC to this at boot, even backwards.
defs = []
if os.getenv('SF32_LOOP_AB') == '1':  # SF32_LOOP_AB=1: battery test: screen-off loop waits for events (45 min) / 25 ms naps (45 min)
    defs.append('SF32_LOOP_AB')
if os.getenv('SF32_LINK_AB') == '1':  # SF32_LINK_AB=1: battery test: low power mode's slow Bluetooth link rhythm off 45 min / on 45 min (phone connected)
    defs.append('SF32_LINK_AB')
if os.getenv('SF32_MOTION_LOG') == '1':  # SF32_MOTION_LOG=1: print the accelerometer every second
    defs.append('SF32_MOTION_LOG')
if os.getenv('SF32_I2C_SCAN') == '1':  # SF32_I2C_SCAN=1: log an I2C bus scan 5 s after boot
    defs.append('SF32_I2C_SCAN_AT_BOOT')
if os.getenv('SF32_PM_LOG') == '1':  # SF32_PM_LOG=1: count time asleep (power manager)
    defs.append('SF32_PM_LOG')
if os.getenv('SF32_SENSOR_PROBE') == '1':  # SF32_SENSOR_PROBE=1: list the motion hub's sensors at boot
    defs.append('SF32_SENSOR_PROBE')
if os.getenv('SF32_SOUND_LOG') == '1':  # SF32_SOUND_LOG=1: print each sound played
    defs.append('SF32_SOUND_LOG')
if os.getenv('SF32_FRAME_LOG') == '1':  # SF32_FRAME_LOG=1: print frame / transition times
    defs.append('SF32_FRAME_LOG')
if os.getenv('SF32_REMOTE_TOUCH') == '1':  # SF32_REMOTE_TOUCH=1: debug builds only: tools/touch.sh taps/swipes over USB
    defs.append('SF32_REMOTE_TOUCH')
if os.getenv('SF32_UI_DEMO'):  # (a value: the touch script)
    defs.append(('SF32_UI_DEMO_SEQ', '\\"' + os.getenv('SF32_UI_DEMO') + '\\"'))
    if os.getenv('SF32_UI_DEMO_TIME'):
        defs.append(('SF32_UI_DEMO_TIME', os.getenv('SF32_UI_DEMO_TIME')))

# variant.h supplies LORA_* defaults used by target.cpp
group = DefineGroup('Platform', src, depend=[''], CPPPATH=[cwd], LOCAL_CPPDEFINES=defs,
                    LOCAL_CCFLAGS=' -include sf32_platform.h -include variant.h -fno-math-errno')  # (sqrtf: the FPU's vsqrt, not a library call)

Return('group')
